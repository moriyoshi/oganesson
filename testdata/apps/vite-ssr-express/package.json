    "react-dom": "19.3.0",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "vite": "8.3.3"
  }
}
